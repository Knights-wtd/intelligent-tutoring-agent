{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [
      "jest"
    ],
    "isolatedModules": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
