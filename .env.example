APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
# Public browser URL embedded when the web image is built; rebuild web after changing it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
POSTGRES_DB=textbook
POSTGRES_USER=textbook
POSTGRES_PASSWORD=replace-for-non-local-use
DATABASE_URL=postgresql+psycopg://textbook:replace-for-non-local-use@postgres:5432/textbook
REDIS_PASSWORD=replace-for-non-local-use
REDIS_URL=redis://:replace-for-non-local-use@redis:6379/0
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=textbook-local
OBJECT_STORAGE_SECRET_KEY=replace-for-non-local-use
OBJECT_STORAGE_BUCKET=textbook-assets
MINIO_ROOT_USER=textbook-local
MINIO_ROOT_PASSWORD=replace-for-non-local-use
