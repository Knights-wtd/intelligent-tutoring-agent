APP_ENV=development
# Docker 构建时的包索引。默认官方 PyPI;如需区域镜像(例如清华源恢复可用时),
# 在被忽略的 .env 中设置 PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple。
# 注意:该镜像可能对部分网络返回 403,表现为 pip 报 "from versions: none"。
PIP_INDEX_URL=https://pypi.org/simple
# Docker 构建 apt 换源(安装 tesseract 用)。默认官方 Debian 源;清华系镜像对本机 403 期间不要改回。
DEBIAN_APT_MIRROR=deb.debian.org
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=session
SESSION_TTL_SECONDS=604800
# Non-secret, non-functional example metadata. Keep real provider credentials only in ignored .env.
# Never put keys or secrets in PROVIDER_PROFILES_JSON, database records, browser variables, or this file.
PROVIDER_PROFILES_JSON=[{"id":"example-chat-model","provider":"openai","model":"example-chat-model","display_name":"Example Chat Model","supports_usage":true,"enabled_by_default":true}]
PLATFORM_ADMIN_EMAILS=admin@example.com
# Leave examples empty. Set real keys only in ignored .env; they are server-only deployment secrets.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Required by the tutor feature: server-only key for the Faro chat provider.
FARO_API_KEY=replace-with-your-faro-api-key
FARO_MODEL=gemini-3.7-flash-tiered
# Optional restricted CONNECT proxy; leave empty unless Docker direct egress fails. See README.
FARO_PROXY_URL=
# Self-service recharge (1 积分 = 1 元). PAYMENT_PROVIDER=mock 为本地/CI 模拟收银台,不发生真实扣款;
# alipay 为支付宝电脑网站支付(RSA2)。切换 alipay 前,以下五项必须在被忽略的 .env 中填入真实商户凭据,
# 不得提交到仓库;ALIPAY_NOTIFY_BASE_URL 是支付宝服务器可回调的本 API 公网 HTTPS 根地址(无路径)。
PAYMENT_PROVIDER=mock
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_BASE_URL=
# wechat 为微信支付 APIv3 Native 扫码支付(真实资金)。切换前必须先在微信支付商户平台开通 Native 产品,
# 并在被忽略的 .env 中填入:商户号、绑定商户号的 AppID、商户 API 证书序列号、apiclient_key.pem 私钥
# PEM、APIv3 密钥(恰 32 位),以及微信支付服务器可回调的本 API 公网 HTTPS 根地址。
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_MCH_SERIAL_NO=
WECHAT_MCH_PRIVATE_KEY=
WECHAT_APIV3_KEY=
WECHAT_GATEWAY_URL=https://api.mch.weixin.qq.com
WECHAT_NOTIFY_BASE_URL=
# Public browser URL embedded when the web image is built; rebuild web after changing it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
POSTGRES_DB=textbook
POSTGRES_USER=textbook
POSTGRES_PASSWORD=replace-with-long-random-postgres-password
DATABASE_URL=postgresql+psycopg://textbook:replace-with-long-random-postgres-password@postgres:5432/textbook
REDIS_PASSWORD=replace-with-long-random-redis-password
REDIS_URL=redis://:replace-with-long-random-redis-password@redis:6379/0
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=textbook-storage-app-local
OBJECT_STORAGE_SECRET_KEY=replace-with-long-random-object-app-secret
OBJECT_STORAGE_BUCKET=textbook-assets
# Server-only HMAC key for opaque citation tokens (tutor 引用). Rotate independently
# from OBJECT_STORAGE_SECRET_KEY; rotating it invalidates previously issued tokens.
CITATION_HMAC_SECRET=replace-with-long-random-citation-hmac-secret
MINIO_ROOT_USER=textbook-minio-admin-local
MINIO_ROOT_PASSWORD=replace-with-long-random-minio-admin-password
# Knowledge-import runtime defaults. The current compose services intentionally rely on these
# application defaults; adding override variables to .env has no effect until compose.yaml maps
# the same variables into both api and worker. Do not represent an unavailable provider as enabled.
# Supported uploads: PDF, DOCX, UTF-8 Markdown, JPEG (.jpg/.jpeg), PNG, and Obsidian vault ZIP.
# KNOWLEDGE_UPLOAD_MAX_BYTES default: 104857600 (100 MiB).
# MAX_VAULT_FILES default: 5000; MAX_VAULT_UNCOMPRESSED_BYTES default: 524288000 (500 MiB).
# OCR_BACKEND default and only accepted value: disabled. OCR_LANGUAGES defaults to eng,chi_sim;
# its runtime OCR helper accepts only eng and chi_sim when invoked. EMBEDDING_BACKEND default and
# only accepted value: hash; EMBEDDING_MODEL: feature-hash-v1; EMBEDDING_DIMENSION default: 384
# (permitted range: 8-4096). No remote OCR or embedding provider is configured by this repository.
