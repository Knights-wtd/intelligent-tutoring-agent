{
  "name": "textbook-agent-platform",
  "private": true,
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "test:agent-protocol": "pnpm --dir packages/agent-protocol test",
    "typecheck:agent-protocol": "pnpm --dir packages/agent-protocol typecheck",
    "test:agent-runtime": "pnpm --dir apps/agent-runtime test",
    "typecheck:agent-runtime": "pnpm --dir apps/agent-runtime typecheck",
    "dev:web": "pnpm --dir apps/web dev",
    "test:web": "pnpm --dir apps/web test",
    "lint:web": "pnpm --dir apps/web lint",
    "build:web": "pnpm --dir apps/web build",
    "check:web-artifacts": "pnpm --dir apps/web check:agent-artifacts"
  }
}
